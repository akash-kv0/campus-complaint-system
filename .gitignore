//gitignore file for the Campus Complaint System project
# Ignore node_modules in both client and server
client/node_modules/
server/node_modules/
node_modules/

# Ignore environment files
.env
.env.*
!.env.example

# Ignore build output
client/build/
server/build/
client/dist/
server/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vscode/
